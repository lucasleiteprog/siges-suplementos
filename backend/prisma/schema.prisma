generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            Int      @id @default(autoincrement())
  nome          String
  username      String   @unique
  password_hash String
  role          String   @default("EMPLOYEE") // Mantido para compatibilidade, mas as flags vão mandar
  
  perm_pacientes_editar   Boolean @default(true)
  perm_pacientes_excluir  Boolean @default(false)
  perm_estoque_editar     Boolean @default(true)
  perm_estoque_excluir    Boolean @default(false)
  perm_listas_base        Boolean @default(false)
  perm_usuarios           Boolean @default(false)

  created_at    DateTime @default(now())
}

model Diagnosis {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  patients Patient[]
}

model Folder {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  patients Patient[]
}

model Ubs {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  patients Patient[]
}

model Formula {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  patients  Patient[]
  batches   Batch[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model Batch {
  id                  Int                 @id @default(autoincrement())
  formulaId           Int
  formula             Formula             @relation(fields: [formulaId], references: [id])
  numero_lote         String
  data_validade       DateTime
  quantidade_inicial  Int
  quantidade_atual    Int
  data_entrada        DateTime            @default(now())
  observacoes         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  dispensingHistories DispensingHistory[]

  @@unique([formulaId, numero_lote])
}

model Patient {
  id                    Int                 @id @default(autoincrement())
  nome                  String
  cpf                   String              @unique
  cartao_sus            String              @unique
  data_nascimento       DateTime
  cids                  String?
  observacoes           String?
  restricoes_clinicas   String?
  diagnoses             Diagnosis[]
  endereco              String?
  bairro                String?
  ubs_id                Int?
  ubs                   Ubs?                @relation(fields: [ubs_id], references: [id])
  folder_id             Int?
  folder                Folder?             @relation(fields: [folder_id], references: [id])
  relatorio_medico      Boolean             @default(false)
  relatorio_nutricional Boolean             @default(false)
  visita_social         Boolean             @default(false)
  forma_alimentacao     String?
  via_acesso_sonda      String?
  peso                  Float?
  altura                Float?
  imc                   Float?
  nome_profissional     String?
  registro_profissional String?
  formulas              Formula[]
  quantidade            Int?
  data_entrega          DateTime?
  data_ultimo_relatorio DateTime?
  status                String              @default("ATIVO") // ATIVO, PENDENTE, FALECIDO, INATIVO
  created_at            DateTime            @default(now())
  history               DispensingHistory[]
}

model DispensingHistory {
  id                     Int          @id @default(autoincrement())
  patient_id             Int
  batch_id               Int
  quantidade             Int
  quem_entregou          String
  quem_recebeu           String
  data_dispensacao       DateTime     @default(now())
  observacoes            String?
  aviso_renovacao_ciente Boolean      @default(false)
  patient                Patient      @relation(fields: [patient_id], references: [id])
  batch                  Batch        @relation(fields: [batch_id], references: [id])
}

model SystemSettings {
  id                      Int      @id @default(autoincrement())
  dias_validade_relatorio Int      @default(90)
  dias_aviso_renovacao    Int      @default(30) // Quantos dias antes do vencimento deve começar a avisar
  updated_at              DateTime @updatedAt
}
